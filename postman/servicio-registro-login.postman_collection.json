      "name": "P-01 Consultar el servicio",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Código de estado 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Responde en formato JSON\", () => pm.response.to.be.json);",
              "pm.test(\"Responde en menos de 1 segundo\", () => pm.expect(pm.response.responseTime).to.be.below(1000));",
              "pm.test(\"Lista las rutas del servicio\", () => pm.expect(pm.response.json().rutas).to.eql([\"POST /api/registro\", \"POST /api/login\"]));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": []
        },
        "description": "Comprobar que el servicio está arriba y lista sus rutas.\n\nResultado esperado: 200 con el nombre del servicio y sus dos rutas."
      },
      "response": []
    },
    {
      "name": "P-02 Registrar usuario nuevo",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Código de estado 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"Responde en formato JSON\", () => pm.response.to.be.json);",
              "pm.test(\"Responde en menos de 1 segundo\", () => pm.expect(pm.response.responseTime).to.be.below(1000));",
              "pm.test(\"Mensaje: «Usuario registrado correctamente.»\", () => pm.expect(pm.response.json().mensaje).to.eql(\"Usuario registrado correctamente.\"));",
              "pm.test(\"Devuelve el usuario registrado\", () => pm.expect(pm.response.json().usuario).to.eql(pm.variables.get(\"usuario\")));",
              "pm.test(\"No devuelve la contraseña ni su hash\", () => { const c = pm.response.json(); pm.expect(c).to.not.have.property(\"contrasena\"); pm.expect(c).to.not.have.property(\"hashContrasena\"); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"usuario\": \"{{usuario}}\",\n  \"contrasena\": \"{{contrasena}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/registro",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "registro"
          ]
        },
        "description": "Registrar un usuario con datos válidos.\n\nResultado esperado: 201 «Usuario registrado correctamente.» sin devolver la contraseña."
      },
      "response": []
    },
